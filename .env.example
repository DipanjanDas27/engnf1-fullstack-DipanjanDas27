# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triagesync

# JWT Authentication
JWT_SECRET=dummy_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# CORS & Client URL
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variables (for frontend/.env)
VITE_API_URL=http://localhost:8000/api
